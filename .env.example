# คัดลอกเป็น .env แล้วแก้ค่าของเครื่องที่ติดตั้ง
# ไฟล์นี้มีเฉพาะค่าเริ่มต้น ห้ามใส่รหัสลับจริงลงในไฟล์ตัวอย่าง

# image ที่ build ด้วย Dockerfile ของโปรเจกต์
KHANWAI_IMAGE=khanwai:0.11.0

# ค่าเริ่มต้นเปิดเฉพาะเครื่องเซิร์ฟเวอร์
# ถ้าจะเข้าผ่าน IP จากมือถือ/เครื่องอื่น ให้เปลี่ยนเป็น 0.0.0.0
BIND_ADDRESS=127.0.0.1
PORT=4173

# ตำแหน่งภายใน container ข้อมูลจริงอยู่ใน named volume ของ Compose
# ไม่ใช่ตำแหน่งโฟลเดอร์บน host; โดยปกติไม่ต้องแก้
DATA_DIR=/data

# เว้นว่างได้เมื่อลองเปิด HTTP ผ่าน IP โดยตรง
# ถ้าใช้โดเมน/HTTPS ให้ใส่ URL ที่เปิดจริง เช่น https://books.example.com
# ไม่ใส่ path หรือเครื่องหมาย / ท้าย URL
APP_ORIGIN=

# เปิดไว้ตอนสมัครบัญชีแรก แล้วเปลี่ยนเป็น false เพื่อปิดรับสมัครเพิ่ม
ALLOW_REGISTRATION=true

# ตั้ง true เมื่อเข้าเว็บผ่าน HTTPS แล้วเท่านั้น
# APP_ORIGIN ที่ขึ้นต้น https:// จะเปิด secure cookie ให้อัตโนมัติด้วย
COOKIE_SECURE=false

# ตัวเลือกเสริมสำหรับ Google Books; เริ่มใช้แอพได้โดยไม่ต้องมีคีย์
# ใส่คีย์จริงเฉพาะใน .env ของเซิร์ฟเวอร์
GOOGLE_BOOKS_API_KEY=
